{
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/*.env)",
      "Read(./**/secrets/**)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Edit(./.claude/settings*.json)",
      "Edit(./.claude/desbaste.json)",
      "Edit(./.claude/hooks/**)",
      "Bash(git push *--force*)",
      "Bash(git push -f:*)",
      "Bash(git push * -f*)",
      "Bash(git reset *--hard*)",
      "Bash(git stash)",
      "Bash(pkill *-f*)",
      "Bash(killall:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-git-commit.py\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "desbaste@desbaste": true
  }
}
