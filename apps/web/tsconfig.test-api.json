{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "tsBuildInfoFile": "dist/tsconfig.test-api.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node", "vite-plugin-pwa/client"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  },
  "include": [
    "src",
    "test/sync/api-support.ts",
    "test/write/cloud-write.test.tsx",
    "test/sync/cloud-boot.test.tsx",
    "test/sync/cloud-device.test.tsx",
    "test/ecb-drafts.test.tsx",
    "test/helpers/render.tsx",
    "test/helpers/golden.ts",
    "test/helpers/memory-blob.ts",
    "../../packages/adapters/test/fake-idb.ts",
    "../../packages/adapters/test/fixtures.ts",
    "../api/test/harness.ts",
    "../../packages/adapters/test/aws/test-only-fake-s3.ts",
    "../../packages/adapters/test/aws/test-only-fake-ssm.ts",
    "../../packages/adapters/test/identity/test-only-fake-google.ts"
  ],
  "references": [
    {
      "path": "../../packages/domain"
    },
    {
      "path": "../../packages/adapters"
    },
    {
      "path": "../api"
    }
  ]
}
