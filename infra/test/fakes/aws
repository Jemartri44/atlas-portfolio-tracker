#!/usr/bin/env node
// TEST ONLY: a fake `aws` for the rehearsals of the scripts of infra/ (feature 017, E4;
// plan.md (h)). It never reaches a network: it answers from the JSON file FAKE_AWS_STATE
// and records every call (its arguments, one line each) in FAKE_AWS_LOG.
import { appendFileSync, readFileSync, writeFileSync } from "node:fs";

const args = process.argv.slice(2);
appendFileSync(process.env.FAKE_AWS_LOG, `${args.join(" ")}\n`);
const state = JSON.parse(readFileSync(process.env.FAKE_AWS_STATE, "utf8"));
const save = () => writeFileSync(process.env.FAKE_AWS_STATE, JSON.stringify(state));
const flag = (name) => {
  const at = args.indexOf(`--${name}`);
  return at === -1 ? undefined : args[at + 1];
};
const say = (value) => process.stdout.write(`${JSON.stringify(value)}\n`);
const [service, operation] = args.filter((arg, i) => !arg.startsWith("--") && (i === 0 || !args[i - 1].startsWith("--")));

if (state.fail?.includes(operation)) {
  process.stderr.write(`An error occurred (${operation}): SECRET-IN-MESSAGE\n`);
  process.exit(254);
}
if (service === "cloudfront" && operation === "list-tags-for-resource") {
  say({ Tags: { Items: state.tags?.[flag("resource")] ?? [] } });
} else if (service === "wafv2" && operation === "list-tags-for-resource") {
  say({ TagInfoForResource: { TagList: state.tags?.[flag("resource-arn")] ?? [] } });
} else if (service === "pricing-plan-manager" && operation === "list-subscriptions") {
  say({ subscriptionSummaries: state.subscriptions });
} else if (service === "pricing-plan-manager" && operation === "create-subscription") {
  const index = state.subscriptions.length + 1;
  const arns = args.slice(args.indexOf("--resource-arns") + 1).filter((arg) => !arg.startsWith("--") || false);
  const list = [];
  for (const arg of args.slice(args.indexOf("--resource-arns") + 1)) {
    if (arg.startsWith("--")) break;
    list.push(arg);
  }
  void arns;
  state.subscriptions.push({ arn: `sub-${index}`, planFamily: flag("plan-family"), planTier: flag("plan-tier"), status: "ACTIVE", resourceArns: list, eTag: `etag-${index}` });
  save();
  say({ subscription: state.subscriptions.at(-1) });
} else if (service === "pricing-plan-manager" && operation === "cancel-subscription") {
  const found = state.subscriptions.find((entry) => entry.arn === flag("arn"));
  if (!found || found.eTag !== flag("if-match")) process.exit(254);
  found.scheduledChange = { type: "CANCELLATION" };
  save();
  say({ subscription: found });
} else {
  process.stderr.write("fake aws: unknown order\n");
  process.exit(2);
}
