{
  "name": "atlas-portfolio-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Personal investment portfolio manager: append-only ledger, FIFO lots, Spanish tax preparation",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "atlas": "node apps/cli/dist/main.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
