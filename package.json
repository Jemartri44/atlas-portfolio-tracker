{
  "name": "atlas-portfolio-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Personal investment portfolio manager: append-only ledger, FIFO lots, Spanish tax preparation",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "build": "tsc -b && npm run build -w @atlas/web",
    "clean": "rm -rf packages/*/dist packages/*/dist-test packages/*/coverage apps/*/dist apps/*/dist-test tests/dist coverage node_modules/.vite",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "atlas": "node apps/cli/dist/main.js",
    "dev": "npm run dev -w @atlas/web",
    "preview": "npm run preview -w @atlas/web"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.9.0",
    "happy-dom": "20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  }
}
