{
  "name": "@atlas/adapters",
  "version": "0.1.0",
  "private": true,
  "description": "Port implementations: in-memory and file LedgerStore, system Clock.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./blob": {
      "types": "./dist/ledger-store/blob.d.ts",
      "import": "./dist/ledger-store/blob.js"
    },
    "./browser": {
      "types": "./dist/ledger-store/browser/index.d.ts",
      "import": "./dist/ledger-store/browser/index.js"
    },
    "./reference": {
      "types": "./dist/ledger-store/browser/reference.d.ts",
      "import": "./dist/ledger-store/browser/reference.js"
    },
    "./drafts": {
      "types": "./dist/ledger-store/browser/drafts.d.ts",
      "import": "./dist/ledger-store/browser/drafts.js"
    },
    "./folder": {
      "types": "./dist/ledger-store/browser/folder.d.ts",
      "import": "./dist/ledger-store/browser/folder.js"
    },
    "./transfer": {
      "types": "./dist/ledger-store/browser/transfer.d.ts",
      "import": "./dist/ledger-store/browser/transfer.js"
    },
    "./clock": {
      "types": "./dist/clock/system.d.ts",
      "import": "./dist/clock/system.js"
    },
    "./random": {
      "types": "./dist/random/web-crypto.d.ts",
      "import": "./dist/random/web-crypto.js"
    }
